# Cloudflare Pages headers, applied at the edge.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cdn.jsdelivr.net https://api.zippopotam.us https://geo.fcc.gov https://api.open-meteo.com https://air-quality-api.open-meteo.com https://api.weather.gov https://www.fema.gov

# The embed widget is meant to be framed by other sites. Pages serves
# embed.html at the pretty URL /embed, so both paths need the rule.
/embed
  ! X-Frame-Options
/embed.html
  ! X-Frame-Options

# HTML: short cache so page chrome stays fresh
/*.html
  Cache-Control: public, max-age=300, must-revalidate
/
  Cache-Control: public, max-age=300, must-revalidate

# Data files: rules and numbers can be corrected at any time
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# Scripts and styles are versioned with ?v= in the HTML
/scripts/*
  Cache-Control: public, max-age=3600
/styles/*
  Cache-Control: public, max-age=3600
